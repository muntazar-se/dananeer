# ==============================================================================
# Dananir (دنانير) - Environment Configuration
# Free tiers: Supabase, Vercel, Cloudflare R2
# ==============================================================================

# 1. Supabase (Free Tier: 500MB DB, 50,000 monthly active users, RLS)
# Get these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Cloudflare R2 (Free Tier: 10GB storage, 1M write/month, 10M read/month, 0 egress fees)
# Get these from: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=dananir-assets
CLOUDFLARE_R2_PUBLIC_URL=https://assets.dananeer.store

# 3. App Settings
NEXT_PUBLIC_APP_URL=https://dananeer.store
NEXT_PUBLIC_WHATSAPP_SUPPORT=+9647700000000
